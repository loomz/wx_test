/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}

/* 通用样式 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

/* 按钮样式 */
button {
  border: none;
  outline: none;
  cursor: pointer;
}

/* 输入框样式 */
input {
  border: none;
  outline: none;
  font-size: 28rpx;
}

/* 图片样式 */
image {
  display: block;
}

/* 通用间距 */
.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

/* 通用布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}