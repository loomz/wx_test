.mine-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 用户信息部分 */
.user-info {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-details {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
  margin-right: 20rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: #666;
}

.edit-btn {
  background-color: #007aff;
  color: #fff;
  border: none;
  padding: 10rpx 30rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 邀请好友部分 */
.invite-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.share-options {
  display: flex;
  justify-content: space-around;
}

.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

/* 个人中心选项 */
.center-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.center-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.center-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

/* 其他选项 */
.other-section {
  background-color: #fff;
}

.other-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.other-item:last-child {
  border-bottom: none;
}

.logout {
  color: #ff3b30;
  font-weight: bold;
  margin-top: 20rpx;
}