<view class="mine-container">
  <!-- 用户信息部分 -->
  <view class="user-info">
    <view class="user-details">
      <view class="user-avatar"></view>
      <view class="user-text">
        <view class="user-name">用户名</view>
        <view class="user-id">用户ID: 12345678</view>
      </view>
    </view>
    <button class="edit-btn">编辑资料</button>
  </view>

  <!-- 邀请好友部分 -->
  <view class="invite-section">
    <view class="section-title">邀请好友，共创灵感</view>
    <view class="share-options">
      <view class="share-item" bindtap="shareToWechat">
        <image src="../../images/wechat.png" class="share-icon"></image>
        <text>微信</text>
      </view>
      <view class="share-item" bindtap="shareToMoments">
        <image src="../../images/moments.png" class="share-icon"></image>
        <text>朋友圈</text>
      </view>
      <view class="share-item" bindtap="shareToQQ">
        <image src="../../images/qq.png" class="share-icon"></image>
        <text>QQ好友</text>
      </view>
      <view class="share-item" bindtap="copyLink">
        <image src="../../images/link.png" class="share-icon"></image>
        <text>复制链接</text>
      </view>
    </view>
  </view>

  <!-- 个人中心选项 -->
  <view class="center-section">
    <view class="center-item" bindtap="goToHistory">
      <text>生成记录</text>
      <text class="arrow">></text>
    </view>
    <view class="center-item" bindtap="goToCollection">
      <text>我的收藏</text>
      <text class="arrow">></text>
    </view>
    <view class="center-item" bindtap="goToInspirationCenter">
      <text>灵感中心</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 其他选项 -->
  <view class="other-section">
    <view class="other-item" bindtap="goToVersionPlan">
      <text>版本规划</text>
      <text class="arrow">></text>
    </view>
    <view class="other-item" bindtap="contactService">
      <text>联系客服</text>
      <text class="arrow">></text>
    </view>
    <view class="other-item" bindtap="goToSettings">
      <text>设置</text>
      <text class="arrow">></text>
    </view>
    <view class="other-item logout" bindtap="logout">
      <text>退出登录</text>
    </view>
  </view>
</view>