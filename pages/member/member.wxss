.member-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 30rpx;
}

/* 会员头部 */
.member-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.member-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.member-subtitle {
  font-size: 24rpx;
  color: #666;
}

/* 套餐部分 */
.package-section {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 套餐项 */
.package-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

/* 三年会员特殊样式 */
.package-item.three-year {
  border: 2rpx solid #ff9500;
}

.package-item.three-year::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 120rpx;
  background-color: #ff9500;
  border-radius: 0 20rpx 0 120rpx;
  z-index: 1;
}

/* 套餐头部 */
.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 2;
}

.package-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.package-discount {
  background-color: #ff9500;
  color: #fff;
  font-size: 20rpx;
  padding: 5rpx 15rpx;
  border-radius: 15rpx;
  font-weight: bold;
}

/* 套餐价格 */
.package-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 30rpx;
}

.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff3b30;
  margin-right: 10rpx;
}

.price-unit {
  font-size: 24rpx;
  color: #666;
}

/* 套餐功能 */
.package-features {
  margin-bottom: 30rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.feature-check {
  color: #4cd964;
  font-size: 28rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
}

/* 购买按钮 */
.package-btn {
  width: 100%;
  background-color: #007aff;
  color: #fff;
  border: none;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* 会员底部 */
.member-footer {
  margin-top: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 20rpx;
  color: #999;
}