.index-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 上部分：头部图 */
.header-section {
  position: relative;
  margin-bottom: 20rpx;
}

.header-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.header-text {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* 中部分：功能按钮 */
.function-section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.function-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.function-item {
  width: 48%;
  height: 150rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.function-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 下部分：推荐内容 */
.recommend-section {
  background-color: #fff;
  padding-bottom: 20rpx;
}

/* 页签 */
.recommend-tabs {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 0 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #007aff;
}

/* 推荐内容 */
.recommend-content {
  padding: 20rpx 30rpx;
}

.recommend-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.recommend-item {
  width: 48%;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.recommend-image {
  width: 100%;
  height: 250rpx;
  object-fit: cover;
}

.favorite-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite-icon {
  width: 25rpx;
  height: 25rpx;
}