.inspiration-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索框 */
.search-section {
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  border-radius: 30rpx;
  padding: 15rpx 20rpx;
}

.search-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 15rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 分类内容 */
.content-section {
  display: flex;
  min-height: calc(100vh - 120rpx);
}

/* 左侧分类页签 */
.category-tabs {
  width: 180rpx;
  background-color: #f5f5f5;
  border-right: 1rpx solid #e0e0e0;
}

.tab-item {
  padding: 30rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  background-color: #fff;
  color: #007aff;
  font-weight: bold;
  border-left: 4rpx solid #007aff;
}

/* 右侧效果图展示 */
.effect-section {
  flex: 1;
  background-color: #fff;
  padding: 20rpx;
}

.effect-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.effect-item {
  width: 30%;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.effect-image {
  width: 100%;
  height: 200rpx;
  object-fit: cover;
}